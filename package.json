{
  "name": "gland-http-monorepo",
  "private": true,
  "version": "2.0.0",
  "description": "Gland's HTTP transport layer: one framework-agnostic core and a pluggable adapter per server.",
  "homepage": "https://github.com/glandjs/http#readme",
  "author": {
    "name": "Mahdi",
    "url": "https://github.com/m-mdy-m"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run build:http && pnpm run build:adapters",
    "build:http": "pnpm --filter ./packages/http build",
    "build:adapters": "pnpm --filter ./packages/express --filter ./packages/fastify --filter ./packages/koa --filter ./packages/hono --filter ./packages/node build",
    "build:examples": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -b packages/tsconfig.json",
    "clean": "tsc -b packages --clean",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "mocha --require ts-node/register \"test/unit/**/*.spec.ts\"",
    "test:integration": "mocha --require ts-node/register \"test/integration/**/*.spec.ts\"",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:alpha": "changeset publish --tag alpha"
  },
  "lint-staged": {
    "*.ts": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glandjs/http.git"
  },
  "bugs": {
    "url": "https://github.com/glandjs/http/issues"
  },
  "keywords": [
    "gland",
    "glandjs",
    "http",
    "adapter",
    "express",
    "fastify",
    "koa",
    "hono",
    "nodejs",
    "web",
    "framework",
    "typescript",
    "event-driven"
  ],
  "engines": {
    "node": ">= 20"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.1.1",
    "@glandjs/common": "^2.0.0",
    "@glandjs/core": "^2.0.0",
    "@glandjs/events": "^2.0.0",
    "@glandjs/express": "workspace:*",
    "@glandjs/fastify": "workspace:*",
    "@glandjs/hono": "workspace:*",
    "@glandjs/http": "workspace:*",
    "@glandjs/koa": "workspace:*",
    "@glandjs/node": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@medishn/toolkit": "^1.0.4",
    "@types/chai": "^4.3.19",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.0.0",
    "@types/sinon": "^17.0.3",
    "chai": "^4.3.7",
    "express": "^5.1.0",
    "husky": "^9.1.7",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "lint-staged": "^15.5.0",
    "mocha": "^10.7.3",
    "prettier": "^3.5.3",
    "reflect-metadata": "^0.2.2",
    "sinon": "^19.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
