{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "removeComments": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useUnknownInCatchVariables": false,
    "allowJs": false,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".",
    "paths": {
      "@glandjs/http": ["./http"],
      "@glandjs/http/*": ["./http/*"],
      "@glandjs/express": ["./express"],
      "@glandjs/express/*": ["./express/*"],
      "@glandjs/fastify": ["./fastify"],
      "@glandjs/fastify/*": ["./fastify/*"],
      "@glandjs/koa": ["./koa"],
      "@glandjs/koa/*": ["./koa/*"],
      "@glandjs/hono": ["./hono"],
      "@glandjs/hono/*": ["./hono/*"],
      "@glandjs/node": ["./node"],
      "@glandjs/node/*": ["./node/*"]
    },
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noImplicitOverride": false,
    "strictPropertyInitialization": false,
    "noLib": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "**/*.d.ts"]
}
