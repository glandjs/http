{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "composite": false,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useUnknownInCatchVariables": false,
    "allowJs": false,
    "skipLibCheck": true,
    "types": ["node", "mocha", "chai"],
    "noEmit": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noImplicitOverride": false,
    "strictPropertyInitialization": false,
    "paths": {
      "@glandjs/http": ["./packages/http"],
      "@glandjs/http/*": ["./packages/http/*"],
      "@glandjs/express": ["./packages/express"],
      "@glandjs/fastify": ["./packages/fastify"],
      "@glandjs/koa": ["./packages/koa"],
      "@glandjs/hono": ["./packages/hono"],
      "@glandjs/node": ["./packages/node"]
    }
  },
  "include": ["examples/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "**/*.d.ts", "**/*.js"]
}
